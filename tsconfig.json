{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "@playwright/test"]
  },
  "include": ["fixtures/**/*.ts", "pages/**/*.ts", "test-data/**/*.ts", "tests/**/*.ts", "utils/**/*.ts", "playwright.config.ts"]
}
