# Start with the official Jenkins inbound-agent image
FROM jenkins/inbound-agent:jdk21

# Switch to root temporarily to install packages
USER root

# Install Python, pip, virtual environment support, and Git
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git && \
    rm -rf /var/lib/apt/lists/*

# Return to the Jenkins user for normal operation
USER jenkins